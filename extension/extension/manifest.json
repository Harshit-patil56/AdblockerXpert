{
    "name": "AdBlockerXpert",
    "version": "1.0.2",
    "manifest_version": 2,
    "browser_action": {
        "default_popup": "popup.html",
        "default_icon": "logo.png"
    },
    "icons": {
        "128": "logo.png"
    },
    "permissions": [
        "activeTab",
    "declarativeNetRequest",
        "tabs","management", "storage",
        "activeTab", 
    "webNavigation",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>",
    "notifications"
    ],

    "content_scripts": [
        {
          "matches": ["<all_urls>"],
          "js": ["content.js"]
        }
      ],

     "background": {
    "page": "background.html"
  },
        


    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset_1",
                "enabled": true,
                "path": "rules.json"
            }
        ]
    }
}


